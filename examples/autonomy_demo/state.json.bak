  "claims": {
    "clm_9ba0267aea": {
      "id": "clm_9ba0267aea",
      "text": "Insertion sort is faster than merge sort on nearly-sorted input because the number of inversions is small and the work approaches linear.",
      "status": "speculation",
      "confidence": 0.25,
      "source_ids": [
        "src_b2481390ad"
      ],
      "notes": "external claim; not measured by ORIGIN",
      "created_at": 1786481373.1805656,
      "passage": "Insertion sort is faster than merge sort on nearly-sorted input because the number of inversions is small and the work approaches linear.",
      "passage_offset": 24,
      "extraction_method": "deterministic declarative-sentence extractor",
      "extracted_at": 1786481373.180562,
      "claim_type": "comparative",
      "limitations": "extracted from external text; not measured by ORIGIN"
    },
    "clm_cdef10f89c": {
      "id": "clm_cdef10f89c",
      "text": "Merge sort is a stable comparison sort with guaranteed n log n behaviour on every input distribution.",
      "status": "speculation",
      "confidence": 0.25,
      "source_ids": [
        "src_b2481390ad"
      ],
      "notes": "external claim; not measured by ORIGIN",
      "created_at": 1786481373.180655,
      "passage": "Merge sort is a stable comparison sort with guaranteed n log n behaviour on every input distribution.",
      "passage_offset": 163,
      "extraction_method": "deterministic declarative-sentence extractor",
      "extracted_at": 1786481373.1806529,
      "claim_type": "descriptive",
      "limitations": "extracted from external text; not measured by ORIGIN"
    },
    "clm_209c9e93ec": {
      "id": "clm_209c9e93ec",
      "text": "Any comparison sort requires Omega(n log n) comparisons in the worst case.",
      "status": "fact",
      "confidence": 0.97,
      "source_ids": [
        "src_0e8bf0b6a1"
      ],
      "notes": "",
      "created_at": 1786481373.1888733,
      "passage": "",
      "passage_offset": -1,
      "extraction_method": "",
      "extracted_at": 0.0,
      "claim_type": "",
      "limitations": ""
    },
    "clm_141746f697": {
      "id": "clm_141746f697",
      "text": "Insertion sort runs in O(n + inversions); it is linear on nearly-sorted input.",
      "status": "fact",
      "confidence": 0.97,
      "source_ids": [
        "src_0e8bf0b6a1"
      ],
      "notes": "",
      "created_at": 1786481373.188879,
      "passage": "",
      "passage_offset": -1,
      "extraction_method": "",
      "extracted_at": 0.0,
      "claim_type": "",
      "limitations": ""
    },
    "clm_230b5bae2f": {
      "id": "clm_230b5bae2f",
      "text": "Quicksort's worst case is O(n^2), but median-of-three pivoting avoids it on sorted/reversed inputs.",
      "status": "fact",
      "confidence": 0.97,
      "source_ids": [
        "src_0e8bf0b6a1"
      ],
      "notes": "",
      "created_at": 1786481373.1888833,
      "passage": "",
      "passage_offset": -1,
      "extraction_method": "",
      "extracted_at": 0.0,
      "claim_type": "",
      "limitations": ""
    }
  },
  "hypotheses": {
    "hyp_48de48fcea": {
      "id": "hyp_48de48fcea",
      "statement": "Insertion sort is the fastest candidate on nearly-sorted input, and the slowest on random input, at the tested sizes.",
      "rationale": "Adaptive O(n + inversions) behavior dominates on low-inversion input; O(n^2) dominates on random input.",
      "status": "weakened",
      "predictions": [
        {
          "id": "pred_b2e040c3ad",
          "text": "insertion_sort is fastest on nearly_sorted",
          "check": {
            "type": "fastest_on",
            "algorithm": "insertion_sort",
            "regime": "nearly_sorted"
          },
          "outcome": "confirmed",
          "detail": "fastest_on on 'nearly_sorted' is insertion_sort (0.0 ms, margin 407% over shell_sort, separation 0.02 ms > required 0.00 ms) [n=128, 5 trials]"
        },
        {
          "id": "pred_2a821b3ce3",
          "text": "insertion_sort is slowest on random",
          "check": {
            "type": "slowest_on",
            "algorithm": "insertion_sort",
            "regime": "random"
          },
          "outcome": "inconclusive",
          "detail": "insertion_sort has the lowest mean on 'random' (0.1 ms) but is not decisively slower than merge_sort: uncertainty_overlap (gap 0.025 ms <= 3x combined SEM 0.033 ms) [n=128, 5 trials]"
        }
      ],
      "supporting_evidence": [
        "evd_ca511be854"
      ],
      "contradicting_evidence": [],
