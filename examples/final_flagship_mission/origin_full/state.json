    "clm_11da2f3007": {
      "id": "clm_11da2f3007",
      "text": "Dijkstra with a binary heap runs in O((V+E) log V) on graphs with non-negative weights.",
      "status": "fact",
      "confidence": 0.95,
      "source_ids": [
        "src_d3529c5798"
      ],
      "notes": "asymptotic result; says nothing about constant factors at the tested sizes",
