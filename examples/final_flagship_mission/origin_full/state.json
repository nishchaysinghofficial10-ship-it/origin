      "extraction_method": "",
      "extracted_at": 0.0,
      "claim_type": "",
      "limitations": ""
    },
    "clm_2fdd1abb04": {
      "id": "clm_2fdd1abb04",
      "text": "Bellman-Ford runs in O(V*E) and tolerates negative weights, which are not present in this benchmark.",
