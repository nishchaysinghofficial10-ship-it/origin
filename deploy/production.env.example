# Copy to .env.production on the server. This file contains no credential.
ORIGIN_BETA_HOST=beta.example.com
ORIGIN_PUBLIC_SITE_ORIGIN=https://nishchaysinghofficial10-ship-it.github.io
ORIGIN_WEB_ACCEPT_JOBS=1

# Switch this value to the name of a separately restored volume during recovery.
ORIGIN_DATA_VOLUME=origin-beta-data
ORIGIN_BACKUP_VOLUME=origin-beta-backups
ORIGIN_CADDY_DATA_VOLUME=origin-beta-caddy-data
ORIGIN_CADDY_CONFIG_VOLUME=origin-beta-caddy-config
